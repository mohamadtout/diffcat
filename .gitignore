# OS / editors
.DS_Store
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Secrets that must never be committed
*.keystore
*.jks
key.properties

# Never commit tokens, env files or private notes
*.token
*.pem
.env
.env.*
*.local.md

# Store images: large and regenerated with `make store-frames` (see store/README.md).
# Only the Android phone and 10" tablet sets are committed, for the README.
store/screenshots/*
!store/screenshots/google-play/
store/screenshots/google-play/*
!store/screenshots/google-play/phone/
!store/screenshots/google-play/tablet-10/
