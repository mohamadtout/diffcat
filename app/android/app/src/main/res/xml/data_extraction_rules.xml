<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing goes to cloud backups or device-to-device transfers.
     Offline copies can be private source code, and secure storage can't be
     restored anyway (its Keystore key never leaves the device). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
